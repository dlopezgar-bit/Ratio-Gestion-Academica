      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='10'>Evolución de Matrícula (Agosto vs. Octubre 2026)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='RatiosMeses' name='federated.14ygf0a0di0up51934047107yhgg' />
          </datasources>
          <datasource-dependencies datasource='federated.14ygf0a0di0up51934047107yhgg'>
            <column caption='Estudiantes Únicos' datatype='real' name='[Calculation_2600828846161063936]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM(IF [Cargo_TipoPersona] = &apos;Director&apos; THEN [Estudiantes] END))' />
